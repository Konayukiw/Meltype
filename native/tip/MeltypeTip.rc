#include <winver.h>

// 1 つ目のアイコン (言語の切り替えの一覧に出る)
101 ICON "meltype.ico"

// DLL の版は Meltype.exe の版とは別に、DLL を変えたときだけ上げる
// (同じ DLL なら入れ直したときに登録し直さない (管理者権限の確認を出さない) ため、アプリの版を埋め込まない)
VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "041104B0"
    BEGIN
      VALUE "CompanyName", "lnkiai"
      VALUE "FileDescription", "Meltype IME (TSF)"
      VALUE "FileVersion", "1.0.0"
      VALUE "LegalCopyright", "Copyright (C) 2026 lnkiai. GPL-3.0-or-later"
      VALUE "ProductName", "Meltype"
      VALUE "ProductVersion", "1.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x411, 1200
  END
END
